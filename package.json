{
    "name": "tuck",
    "publisher": "PeterJCLaw",
    "repository": "https://github.com/PeterJCLaw/vscode-tuck",
    "displayName": "Tuck",
    "description": "Semi-automated python formatting",
    "license": "Apache-2.0",
    "version": "0.3.0",
    "engines": {
        "vscode": "^1.140.0"
    },
    "categories": [
        "Formatters"
    ],
    "main": "./dist/extension.js",
    "extensionDependencies": [
        "ms-python.python"
    ],
    "contributes": {
        "commands": [
            {
                "command": "tuck.wrap-at-cursor",
                "title": "Tuck: Wrap statement at Cursor"
            }
        ],
        "configuration": {
            "title": "Tuck",
            "properties": {
                "tuck.tuckPath": {
                    "default": "",
                    "markdownDescription": "Path to directory containing an install of `tuck` and its dependencies. Will be prepended to `$PYTHONPATH` for use instead of the version packaged with the extension.",
                    "scope": "machine-overridable",
                    "type": "string"
                }
            }
        },
        "keybindings": [
            {
                "command": "tuck.wrap-at-cursor",
                "key": "alt+shift+w",
                "when": "editorTextFocus && editorLangId == python && !findInputFocussed && !replaceInputFocussed"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "yarn run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "@types/vscode": "^1.140.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0",
        "eslint": "^10.5.0",
        "ts-loader": "^9.6.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "webpack": "^5.107.2",
        "webpack-cli": "^7.0.3"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    },
    "dependencies": {
        "@vscode/python-extension": "^1.0.6"
    }
}
